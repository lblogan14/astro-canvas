{
  "format": "astro-canvas/workflow", "version": 1, "id": "sample-subgraph", "name": "Subgraph math",
  "description": "A subgraph instance (add-one) inlined by the compiler.",
  "nodes": {
    "c": {"type": "core.math.constant", "params": {"value": 5.0}},
    "inst": {"type": "subgraph:add1", "title": "Add one"},
    "dbl": {"type": "core.math.expr", "params": {"expression": "x * 2"}, "linked": ["x"]}
  },
  "edges": {
    "e1": {"from": ["c", "out"], "to": ["inst", "value"]},
