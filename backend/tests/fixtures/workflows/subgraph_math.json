  "subgraphs": {
    "add1": {
      "name": "Add one",
      "nodes": {"plus": {"type": "core.math.expr", "params": {"expression": "x + 1"}, "linked": ["x"]}},
      "edges": {},
      "inputs": [{"name": "value", "node": "plus", "port": "x"}],
      "outputs": [{"name": "result", "node": "plus", "port": "out"}]
    }
  }
