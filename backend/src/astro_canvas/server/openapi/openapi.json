            "type": "string"
          },
          "required": {
            "default": true,
            "title": "Required",
            "type": "boolean"
          },
          "type": {
            "description": "Port type id, e.g. ``astro.Spectrum1D``.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "title": "PortSpec",
        "type": "object"
      },
      "PortTypeSpec": {
        "description": "A registered port type.",
