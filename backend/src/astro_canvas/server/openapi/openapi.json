                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preview"
          },
          "version": {
            "default": "1.0.0",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "category"
        ],
        "title": "NodeSpec",
        "type": "object"
      },
      "PackInfo": {
        "description": "Summary of a discovered node pack (full detail at ``/api/packs``).",
