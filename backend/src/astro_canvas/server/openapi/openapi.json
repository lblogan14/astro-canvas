  "info": {
    "title": "Astro Canvas",
    "version": "0.1.0a0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Return ``ok`` and the server version.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/nodes": {
      "get": {
        "description": "Every registered node schema, sorted by id; optionally filtered by exact category.",
        "operationId": "list_nodes_api_nodes_get",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/NodeSpec"
                  },
                  "title": "Response List Nodes Api Nodes Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Nodes",
        "tags": [
          "nodes"
        ]
      }
    },
    "/api/nodes/{node_id}": {
      "get": {
        "description": "One node schema by id.",
        "operationId": "get_node_api_nodes__node_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "node_id",
            "required": true,
            "schema": {
              "title": "Node Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeSpec"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Node",
        "tags": [
          "nodes"
        ]
      }
    },
    "/api/packs": {
      "get": {
        "description": "Discovered packs, including the ones that failed to load (with their error).",
        "operationId": "list_packs_api_packs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PackRecord"
                  },
                  "title": "Response List Packs Api Packs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Packs",
        "tags": [
          "nodes"
        ]
      }
    },
    "/api/system": {
      "get": {
        "description": "Describe the running server: versions, workspace, disk, packs.",
        "operationId": "system_api_system_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "System",
        "tags": [
          "system"
        ]
      }
    },
    "/api/types": {
      "get": {
        "description": "Every registered port type, sorted by id.",
        "operationId": "list_types_api_types_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PortTypeSpec"
                  },
                  "title": "Response List Types Api Types Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Types",
        "tags": [
          "nodes"
        ]
      }
    }
  }
}
