          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "title": "PackInfo",
        "type": "object"
      },
      "PackLoadError": {
        "description": "Recorded (not raised) when a pack's entry point fails to import or register.",
        "properties": {
          "entry_point": {
            "title": "Entry Point",
            "type": "string"
          },
          "error": {
            "title": "Error",
            "type": "string"
