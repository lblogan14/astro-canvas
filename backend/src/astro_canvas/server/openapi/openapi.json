          },
          "is_async": {
            "default": false,
            "title": "Is Async",
            "type": "boolean"
          },
          "module": {
            "default": "",
            "title": "Module",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "outputs": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/PortSpec"
            },
            "title": "Outputs",
            "type": "array"
          },
          "pack": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pack"
          },
          "param_docs": {
