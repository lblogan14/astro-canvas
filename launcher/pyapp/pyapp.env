# PyApp configuration for the click-to-run launcher (design 4.3 tier 2, research R4 section 3).
#
# PyApp is a Rust wrapper that embeds its configuration and nothing else: on first launch it
# downloads a python-build-standalone interpreter and installs the project into it, and every
# later launch is a plain exec. That shape is why it was chosen -- the launcher is signed once
# and its *payload* updates through `astro-canvas-launcher self update`, so a new release needs
# no re-notarisation on macOS and no fresh SmartScreen reputation on Windows.
#
# Read as environment variables by `launcher/pyapp/build.sh` and by `.github/workflows/release.yml`.
# Every option is documented at https://ofek.dev/pyapp/latest/config/.

# --- what to install ---------------------------------------------------------------------------

PYAPP_PROJECT_NAME=astro-canvas

# PYAPP_PROJECT_VERSION is *not* set here: build.sh takes it from the tag on a release and from
# backend/src/astro_canvas/_version.py otherwise, so the two can never disagree.

# The packs ship with the launcher: somebody who clicks an icon should not have to install the
# science separately. These are extra requirements appended to the install command, so they are
# resolved together with the app - a conflict shows up at build time, not on a user's machine.
PYAPP_PIP_EXTRA_ARGS=astro-canvas-core astro-canvas-rbcodes

# --- the interpreter ---------------------------------------------------------------------------

PYAPP_PYTHON_VERSION=3.12
# python-build-standalone, fetched on first launch. `install_only` is the build without the test
# suite and with the standard optimisations - the one everybody ships.
PYAPP_DISTRIBUTION_VARIANT=install_only

# --- how to install it -------------------------------------------------------------------------

# uv, embedded in the launcher, does the install. That also puts a `uv` binary next to the
# interpreter, which is exactly where `manager/uv.py::find_uv` looks first: the pack manager
# works in a click-to-run install with no configuration and no separate uv on PATH.
PYAPP_UV_ENABLED=1
PYAPP_UV_ONLY_BOOTSTRAP=0

# Keep the installation out of the temp directory: it is a few hundred MB of scientific wheels
# and has to survive a reboot.
PYAPP_FULL_ISOLATION=1

# --- what to run -------------------------------------------------------------------------------

PYAPP_EXEC_SPEC=astro_canvas.cli:main

# Deliberately a console binary (no PYAPP_IS_GUI): the first launch downloads the interpreter and
# the wheels *before* any of our Python runs, and its progress can only be seen on a console.
# Once our code is running, `open --first-run` takes over with the splash page.

# --- management ---------------------------------------------------------------------------------

# `astro-canvas-launcher self update` swaps the payload; `self restore` rebuilds the environment
# when an install went wrong (the ComfyUI Desktop lesson in R4: first-run resolution works, but
# it needs an escape hatch).
PYAPP_SELF_COMMAND=self
PYAPP_EXPOSE_METADATA=1
