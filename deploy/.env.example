# Copy to deploy/.env and edit. Everything here has a default except POSTGRES_PASSWORD.

# The domain Caddy serves. `localhost` works for a trial and for CI.
CANVAS_DOMAIN=localhost

# `internal` uses Caddy's own local CA (self-signed). For a real domain put an email address
# here instead and Caddy fetches a Let's Encrypt certificate.
CANVAS_TLS=internal

# Accounts database. Required: compose refuses to start without it.
POSTGRES_PASSWORD=

# These addresses become administrators when they register. Comma-separated.
ADMIN_EMAILS=pi@example.org

# Set false once your group has signed up, and add people with an invitation out of band.
REGISTRATION=true

# `strict` installs registry packs only. A pack install changes what every user of this
# server runs, which is why a shared deployment should not be `permissive`.
PACK_SECURITY=strict

# Set false to serve without /api/manager at all (nobody can install packs, not even an admin).
MANAGER=true

# Sizing. The memory cache is a per-user ceiling; the disk cache is per user too, under /data.
CACHE_MEMORY_MB=1024
CACHE_DISK_GB=50
MAX_WORKERS=4
RUN_TIMEOUT_S=3600
LOG_LEVEL=info

# Host ports. Use 8080/8443 if something else already owns 80/443.
HTTP_PORT=80
HTTPS_PORT=443

# Published image instead of a local build.
# CANVAS_IMAGE=ghcr.io/lblogan14/astro-canvas:0.1.0
