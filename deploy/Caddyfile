# TLS and the reverse proxy in front of Astro Canvas.
#
# `CANVAS_TLS=internal` (the default, and what the compose test uses) makes Caddy issue a
# certificate from its own local CA - real HTTPS with no ACME round trip. Set `CANVAS_TLS` to an
# email address with a public `CANVAS_DOMAIN` and the same directive fetches a Let's Encrypt
# certificate instead; nothing else changes.
{
	admin off
}

{$CANVAS_DOMAIN} {
	tls {$CANVAS_TLS}

	encode zstd gzip

	# Cubes and FITS files travel through here; 8 GiB is a generous ceiling, not a target.
	request_body {
		max_size 8GB
	}

	# The WebSocket carries node events and binary output frames, so it must not be buffered,
	# and a subscribed client is quiet between runs - hence no read timeout on it.
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy app:8765 {
			flush_interval -1
		}
	}

	handle {
		# Caddy passes X-Forwarded-{For,Proto,Host} upstream by itself; the app reads them
		# through uvicorn's `--proxy-headers`. `ASTRO_CANVAS_PUBLIC_URL` is what actually
		# decides the session cookie's Secure flag.
		reverse_proxy app:8765
	}

	header {
		# The SPA is same-origin and loads no third-party script; the canvas needs blob: workers.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' ws: wss:; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format console
	}
}
